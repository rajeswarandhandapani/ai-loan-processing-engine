# ============================================================================
# AI Loan Processing Engine — Backend Environment Configuration
# ============================================================================
# Copy this file to `.env` and fill in your real credentials:
#     cp .env.example .env
#
# NOTE: `.env` is git-ignored and must NEVER be committed. This `.env.example`
# contains placeholders only. All values below map to fields in app/config.py.
# Unset optional values fall back to the defaults defined there.

# ----------------------------------------------------------------------------
# Azure Document Intelligence  (document OCR / form + table extraction)
# ----------------------------------------------------------------------------
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_DOCUMENT_INTELLIGENCE_KEY=<your-document-intelligence-key>

# ----------------------------------------------------------------------------
# LLM Provider Selection
# ----------------------------------------------------------------------------
# Supported values: "azure" (Azure OpenAI) or "anthropic" (Claude)
LLM_PROVIDER=azure

# ----------------------------------------------------------------------------
# Azure OpenAI  (chat completions + embeddings for vector search)
# ----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT_NAME=text-embedding-ada-002
AZURE_OPENAI_API_VERSION=2024-06-01

# ----------------------------------------------------------------------------
# Azure AI Search  (vector search over lending policy docs — RAG)
# ----------------------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://<your-resource>.search.windows.net
AZURE_SEARCH_KEY=<your-search-admin-key>

# ----------------------------------------------------------------------------
# Azure AI Language  (sentiment analysis + entity extraction)
# ----------------------------------------------------------------------------
AZURE_LANGUAGE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
AZURE_LANGUAGE_KEY=<your-language-key>

# ----------------------------------------------------------------------------
# Anthropic Claude  (alternative LLM provider — used when LLM_PROVIDER=anthropic)
# ----------------------------------------------------------------------------
ANTHROPIC_API_KEY=<your-anthropic-api-key>
ANTHROPIC_MODEL=claude-sonnet-5

# ----------------------------------------------------------------------------
# LangSmith Tracing  (optional — debugging / monitoring of LangChain runs)
# ----------------------------------------------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=<your-langsmith-api-key>
LANGSMITH_PROJECT=ai-loan-processing-engine

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------
APP_NAME=AI Loan Processing Engine
DEBUG=false

# ----------------------------------------------------------------------------
# Document Intelligence Cache  (cache extraction results to cut API cost)
# ----------------------------------------------------------------------------
DOCUMENT_CACHE_ENABLED=true
DOCUMENT_CACHE_DIR=.cache/document_intelligence
